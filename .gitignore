## Ignore Visual Studio temporary files, build results, and
## user-specific files

# Visual Studio
.vs/
*.vssscc
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Bb]in/
[Oo]bj/
*_i.c
*_p.c
*.ilk
*.meta
*.obj
*.o
*.pch
*.pdb
*.ipch
*.iobj

# Visual Studio cache/options
*.VC.db
*.VC.VC.opendb

# Rider
.idea/
*.sln.iml

# Visual Studio Code
.vscode/

# NuGet
# The packages folder can be ignored because of Package Restore
packages/
*.nupkg
*.snupkg
project.lock.json
project.fragment.lock.json
artifacts/

# dotnet
project.assets.json
*.rsp
*.DotSettings.user
*.dotCover
*.opendb

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# Publish outputs
publish/
*/publish/

# IIS Express
IISExpress/
/.vs/

# User-specific files
*.rsuser
*.suo
*.user
*.userprefs

# Resharper
_ReSharper*/
*.DotSettings.user

# Test results
TestResults/
*.TestResults
*.trx

# Coverage
coverage/
*.coverage
*.coveragexml

# NPM
node_modules/

# Logs
*.log

# SQL Server files
*.mdf
*.ldf

# DotEnv
.env

# Rider caches
.idea/

# Local appsettings and secrets (keep out of repo)
appsettings.*.Local.json
secrets.json
secrets.*

# Git LFS
*.gitattributes

# Other
*.bak
*.backup
*.swp

# Solution files (include .sln but exclude per-user and unknown formats)
*.slnx.user
